    "@portocalc/shared": "^1.0.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "yahoo-finance2": "^4.0.6",
    "zod": "^4.6.7"
  }

# Port server API
PORT=4000

# Lokasi file SQLite (relatif terhadap folder backend/prisma)
DATABASE_URL="file:./dev.db"

# API key Google Gemini — dapatkan gratis di https://aistudio.google.com/apikey
# Kosongkan untuk memakai insight rule-based (tanpa AI).
GEMINI_API_KEY=""

# Model Gemini yang digunakan
GEMINI_MODEL="gemini-3.8-flash"

# Origin frontend yang diizinkan (CORS)
CORS_ORIGIN="http://localhost:5173"
